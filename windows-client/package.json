{
  "name": "rosti-windows-client",
  "version": "1.5.1",
  "description": "Cliente remoto de control desatendido para Windows - Rosti",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.rosti.windowsclient",
    "productName": "RostiWindowsClient",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rosti Windows Client",
      "runAfterFinish": true
    },
    "asar": true,
    "asarUnpack": [
      "InputSimulator.exe"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "InputSimulator.exe",
      "icon.png",
      "icon.ico",
      "package.json"
    ]
  },
  "dependencies": {
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^26.8.1"
  },
  "author": "Rosti",
  "license": "ISC"
}
