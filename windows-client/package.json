{
  "name": "rosti-windows-client",
  "version": "1.0.0",
  "description": "Cliente remoto de control desatendido para Windows - Rosti",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.rosti.windowsclient",
    "productName": "RostiWindowsClient",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "InputSimulator.exe",
      "package.json"
    ]
  },
  "dependencies": {
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^26.8.1"
  },
  "author": "Rosti",
  "license": "ISC"
}
